rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSpecialAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email == 'mussamatembo3@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSpecialAdminEmail() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'name', 'role', 'organizationId']) &&
        data.keys().hasOnly(['id', 'email', 'name', 'role', 'organizationId', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.name is string && data.name.size() <= 128 &&
        data.organizationId is string && data.organizationId.size() <= 128 &&
        data.role in ['SUPER_ADMIN', 'ORG_ADMIN', 'STAFF', 'AGENT'] &&
        (data.role != 'SUPER_ADMIN' || isSpecialAdminEmail() || isAdmin());
    }

    // Connectivity Test Collection
    match /test/{testId} {
      allow read: if isValidId(testId);
      allow write: if isSignedIn() && isValidId(testId);
    }

    // Admins registry
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || isOwner(adminId));
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && (isSpecialAdminEmail() || isAdmin());
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.id == request.auth.uid);
      allow create: if isValidId(userId) &&
        isSignedIn() &&
        (isOwner(userId) || isAdmin()) &&
        isValidUser(incoming()) &&
        (incoming().id == userId);
      allow update: if isValidId(userId) &&
        isSignedIn() &&
        (isOwner(userId) || isAdmin()) &&
        isValidUser(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isValidId(userId) && isAdmin();
    }
  }
}
